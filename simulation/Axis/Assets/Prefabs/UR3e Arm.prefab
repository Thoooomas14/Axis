--- !u!114 &5385086500727304674
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5967870830985431670}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<ros2_control name=\"ft300_gripper\" type=\"system\">\r\n  <!-- Plugins
    -->\r\n  <hardware>\r\n    <!-- Set use_dummy to true to connect to a dummy driver
    for testing purposes. -->\r\n    <param name=\"use_dummy\">false</param>\r\n   
    <plugin>ign_ros2_control/IgnitionSystem</plugin>\r\n    <plugin>mock_components/GenericSystem</plugin>\r\n   
    <param name=\"mock_sensor_commands\">True</param>\r\n    <param name=\"state_following_offset\">0.0</param>\r\n 
    </hardware>\r\n  <!-- Joint interfaces -->\r\n  <!-- With Gazebo or Hardware,
    they handle mimic joints, so we only need this command interface activated -->\r\n 
    <joint name=\"ft300robotiq_85_left_knuckle_joint\">\r\n    <command_interface
    name=\"position\" />\r\n    <state_interface name=\"position\">\r\n      <param
    name=\"initial_value\">0.7929</param>\r\n    </state_interface>\r\n    <state_interface
    name=\"velocity\" />\r\n  </joint>\r\n  <joint name=\"ft300robotiq_85_right_knuckle_joint\"></joint>\r\n 
    <joint name=\"ft300robotiq_85_left_inner_knuckle_joint\"></joint>\r\n  <joint
    name=\"ft300robotiq_85_right_inner_knuckle_joint\"></joint>\r\n  <joint name=\"ft300robotiq_85_left_finger_tip_joint\"></joint>\r\n 
    <joint name=\"ft300robotiq_85_right_finger_tip_joint\"></joint>\r\n</ros2_control>"
